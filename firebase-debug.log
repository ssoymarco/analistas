[debug] [2026-07-11T06:42:53.488Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/analistas-8ba26/rulesets {"name":"projects/analistas-8ba26/rulesets/2e196142-cf94-48a3-bebc-ba53d862ba6a","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── helpers ────────────────────────────────────────────────────────────────\n\n    // True when the request comes from the authenticated owner of this uid\n    function isOwner(uid) {\n      return request.auth != null && request.auth.uid == uid;\n    }\n\n    // True when the caller is a real (non-anonymous) user\n    function isRealUser() {\n      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';\n    }\n\n    // Validates that a favorites map only contains the allowed fields and types.\n    // ⚠️ rivalTeamIds (Modo Rival, en el cliente desde v1.2.1) FALTABA aquí — el\n    // cliente lo incluye en CADA escritura de favoritos, así que estas reglas\n    // rechazaban TODAS las escrituras de favoritos de usuarios logueados en\n    // silencio, y el reconcile de arranque las \"deshacía\" (bug de favoritos\n    // borrados, reportado 3 jul 2026). Si el cliente agrega un campo nuevo a\n    // FirestoreFavorites, AGREGARLO AQUÍ EN EL MISMO CAMBIO.\n    function validFavorites(fav) {\n      return fav.keys().hasOnly(['matchIds', 'teamIds', 'playerIds', 'leagueIds', 'rivalTeamIds'])\n          && (!('matchIds'     in fav) || fav.matchIds     is list)\n          && (!('teamIds'      in fav) || fav.teamIds      is list)\n          && (!('playerIds'    in fav) || fav.playerIds    is list)\n          && (!('leagueIds'    in fav) || fav.leagueIds    is list)\n          && (!('rivalTeamIds' in fav) || fav.rivalTeamIds is list);\n    }\n\n    // ── users/{uid} ─────────────────────────────────────────────────────────────\n    // Profile + favorites live here.\n    match /users/{uid} {\n\n      // Only the owner can read their own profile\n      allow read: if isOwner(uid);\n\n      // Create: only at first sign-in, must include required fields\n      allow create: if isOwner(uid)\n          && request.resource.data.keys().hasAll(['displayName', 'createdAt'])\n          && request.resource.data.displayName is string\n          && request.resource.data.displayName.size() <= 50;\n\n      // Update: owner only; enforce field-level rules\n      // ⚠️ notificationPrefs FALTABA aquí — NotificationPrefsContext lo escribe\n      // (Modo Estadio/Rival) y era rechazado en silencio, mismo bug de clase\n      // que rivalTeamIds en validFavorites (3 jul 2026). Toda key nueva que el\n      // cliente escriba a users/{uid} DEBE agregarse aquí en el mismo cambio.\n      allow update: if isOwner(uid)\n          && request.resource.data.diff(resource.data).affectedKeys()\n               .hasOnly(['displayName', 'username', 'email', 'favorites',\n                         'pushToken', 'updatedAt', 'authMethod',\n                         'notificationPrefs'])\n          // notificationPrefs must be a map if changed\n          && (!('notificationPrefs' in request.resource.data.diff(resource.data).changedKeys())\n              || request.resource.data.notificationPrefs is map)\n          // displayName max 50 chars if changed\n          && (!('displayName' in request.resource.data.diff(resource.data).changedKeys())\n              || request.resource.data.displayName.size() <= 50)\n          // username max 20 chars if changed\n          && (!('username' in request.resource.data.diff(resource.data).changedKeys())\n              || request.resource.data.username.size() <= 20)\n          // favorites must match expected shape if changed\n          && (!('favorites' in request.resource.data.diff(resource.data).changedKeys())\n              || validFavorites(request.resource.data.favorites));\n\n      // El dueño puede borrar su propio doc — deleteAccount (AuthContext) lo\n      // intenta ANTES de deleteUser y con 'if false' era rechazado en silencio\n      // (catch vacío): el perfil con email/nombre quedaba huérfano PARA SIEMPRE\n      // tras borrar la cuenta (Apple 5.1.1(v)). Auditoría 3 jul 2026.\n      allow delete: if isOwner(uid);\n    }\n\n    // ── usernames/{username} ────────────────────────────────────────────────────\n    // Lookup table: username → uid. Enables unique username enforcement.\n    match /usernames/{username} {\n\n      // Anyone can check if a username exists (needed for availability search)\n      allow read: if request.auth != null;\n\n      // Any authenticated user (including anonymous) can claim a username\n      // as long as the uid stored matches their own\n      allow create: if request.auth != null\n          && request.resource.data.keys().hasOnly(['uid'])\n          && request.resource.data.uid == request.auth.uid;\n\n      // Any authenticated user can delete their own username entry\n      allow delete: if request.auth != null\n          && resource.data.uid == request.auth.uid;\n\n      allow update: if false; // always delete + create for username swap\n    }\n\n    // ── Sports data — public reads, server-only writes ─────────────────────────\n    //\n    // These collections hold public sports data (scores, standings, top\n    // scorers, season indexes, bracket caches). Match results aren't private\n    // — every sports site shows them — so we allow unauthenticated reads\n    // here, which removes a hard dependency on Firebase Auth being\n    // available before the first paint. Writes are blocked at the rule\n    // level; only the Cloud Functions service account (via Admin SDK,\n    // which bypasses these rules) can populate them.\n\n    /// matches/{matchId} — live + scheduled + finished fixtures\n    match /matches/{matchId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// standings/{seasonId} — league tables\n    match /standings/{seasonId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// topscorers/{seasonId} — top scorers per league\n    match /topscorers/{seasonId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// season_fixtures/{seasonId} — lightweight per-season fixtures index.\n    /// One compact doc (no detail/h2h blobs) powering the league-detail\n    /// Partidos list + cup bracket with a single read. Written server-side\n    /// by syncFixtures (see functions/src/season-fixtures-index.ts).\n    match /season_fixtures/{seasonId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// season_index/{leagueId} — list of available seasons per league\n    /// Powers the season picker dropdown in LeagueDetailScreen.\n    match /season_index/{leagueId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// cup_brackets/{seasonId} — cached bracket data for past tournaments\n    /// Populated on-demand the first time a user opens a past WC/cup edition.\n    match /cup_brackets/{seasonId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// teams/{teamId} — club + national team info (badge, founded, stadium, etc.)\n    /// Populated by syncTeams cron daily.\n    match /teams/{teamId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// squads/{seasonId}_{teamId} — full roster per team-season\n    /// Populated by syncSquads cron daily.\n    match /squads/{squadId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// coaches/{coachId} — coach profiles + career stats\n    /// Populated by syncCoaches cron daily.\n    match /coaches/{coachId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// players/{playerId} — player profiles + season stats\n    /// Populated by syncPlayers cron daily.\n    match /players/{playerId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// _meta/appVersion — public version manifest read by useVersionCheck on every launch.\n    /// Other _meta docs (e.g. livescoresSnapshot) remain server-only.\n    match /_meta/appVersion {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// _meta/promoBanner — interruptor remoto del banner promocional in-app\n    /// (Mundial etc.). Shape: { enabled: bool, id: string }. El cliente lo lee\n    /// al abrir Partidos; cambiar `id` re-muestra el banner a quien ya lo\n    /// descartó; `enabled:false` lo apaga sin OTA. Escritura solo por consola.\n    match /_meta/promoBanner {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// _meta/wallpapers — config de la sección Wallpapers + concurso de\n    /// jerseys. Shape: { enabled: bool, prize: {id, title, imageUrl,\n    /// announceAt, socialUrl, termsUrl} | null }. Escritura solo server/consola.\n    match /_meta/wallpapers {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// wallpapers/{id} — catálogo de wallpapers (título, imageUrl, likes).\n    /// `likes` lo mantiene la Cloud Function onWallpaperEntryCreated.\n    match /wallpapers/{wallpaperId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    /// wallpaperEntries/{wallpaperId}_{uid} — participación en la dinámica.\n    /// CREATE-ONCE por el dueño (docId amarrado a su uid, campos exactos,\n    /// uid no-anónimo implícito porque el cliente gatea con isGuest, y el\n    /// server puede filtrar anónimos al elegir ganador). Sin update/delete:\n    /// una participación no se edita ni se retira — auditable para el sorteo.\n    match /wallpaperEntries/{entryId} {\n      allow read: if request.auth != null && entryId.matches('.*_' + request.auth.uid + '$');\n      allow create: if request.auth != null\n        && entryId == request.resource.data.wallpaperId + '_' + request.auth.uid\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.wallpaperId is string\n        && request.resource.data.wallpaperId.size() > 0\n        && request.resource.data.keys().hasOnly(['uid', 'wallpaperId', 'prizeId', 'createdAt']);\n      allow update, delete: if false;\n    }\n\n    /// _meta/leagueSeasons — mapa liga→temporada ACTUAL, escrito por\n    /// syncLeagueSeasons (2×/día). Shape: { seasons: { [leagueId]:\n    /// { seasonId, seasonName, leagueName } }, updatedAt }. El cliente lo lee\n    /// para resolver la temporada vigente en vez del hardcode de\n    /// config/leagues.ts (bug 11-jul-2026: tablas/calendarios de la temporada\n    /// terminada). Escritura solo server.\n    match /_meta/leagueSeasons {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    // ── liveActivities/{regId} ──────────────────────────────────────────────────\n    // Registro de tokens de Live Activity (doc id = `${matchId}_${uid}`).\n    // El cliente crea/actualiza SU registro (incluye invitados — anonymous auth\n    // les da uid real); nadie lee desde el cliente (pollLivescores lee con\n    // admin y empuja los updates por FCM/APNs).\n    match /liveActivities/{regId} {\n      allow read: if false;\n      allow create, update: if request.auth != null\n          && request.resource.data.userId == request.auth.uid\n          && request.resource.data.matchId is string\n          && request.resource.data.keys().hasOnly([\n               'fcmToken', 'activityPushToken', 'matchId', 'platform',\n               'userId', 'createdAt', 'ended', 'lastState'\n             ]);\n      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;\n    }\n\n    // ── Deny everything else (including the rest of _meta) ────────────────────\n    // _meta/livescoresSnapshot is internal diff state for Cloud Functions only —\n    // no client should ever need to read it.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-11T06:42:53.620815Z","metadata":{"services":["cloud.firestore"]}}
