rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────────

    // True when the request comes from the authenticated owner of this uid
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // True when the caller is a real (non-anonymous) user
    function isRealUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Validates that a favorites map only contains the allowed fields and types.
    // ⚠️ rivalTeamIds (Modo Rival, en el cliente desde v1.2.1) FALTABA aquí — el
    // cliente lo incluye en CADA escritura de favoritos, así que estas reglas
    // rechazaban TODAS las escrituras de favoritos de usuarios logueados en
    // silencio, y el reconcile de arranque las "deshacía" (bug de favoritos
    // borrados, reportado 3 jul 2026). Si el cliente agrega un campo nuevo a
    // FirestoreFavorites, AGREGARLO AQUÍ EN EL MISMO CAMBIO.
    function validFavorites(fav) {
      return fav.keys().hasOnly(['matchIds', 'teamIds', 'playerIds', 'leagueIds', 'rivalTeamIds'])
          && (!('matchIds'     in fav) || fav.matchIds     is list)
          && (!('teamIds'      in fav) || fav.teamIds      is list)
          && (!('playerIds'    in fav) || fav.playerIds    is list)
          && (!('leagueIds'    in fav) || fav.leagueIds    is list)
          && (!('rivalTeamIds' in fav) || fav.rivalTeamIds is list);
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────────
    // Profile + favorites live here.
    match /users/{uid} {

      // Only the owner can read their own profile
      allow read: if isOwner(uid);

      // Create: only at first sign-in, must include required fields
      allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 50;

      // Update: owner only; enforce field-level rules
      // ⚠️ notificationPrefs FALTABA aquí — NotificationPrefsContext lo escribe
      // (Modo Estadio/Rival) y era rechazado en silencio, mismo bug de clase
      // que rivalTeamIds en validFavorites (3 jul 2026). Toda key nueva que el
      // cliente escriba a users/{uid} DEBE agregarse aquí en el mismo cambio.
      allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'username', 'email', 'favorites',
                         'pushToken', 'updatedAt', 'authMethod',
                         'notificationPrefs'])
          // notificationPrefs must be a map if changed
          && (!('notificationPrefs' in request.resource.data.diff(resource.data).changedKeys())
              || request.resource.data.notificationPrefs is map)
          // displayName max 50 chars if changed
          && (!('displayName' in request.resource.data.diff(resource.data).changedKeys())
              || request.resource.data.displayName.size() <= 50)
          // username max 20 chars if changed
          && (!('username' in request.resource.data.diff(resource.data).changedKeys())
              || request.resource.data.username.size() <= 20)
          // favorites must match expected shape if changed
          && (!('favorites' in request.resource.data.diff(resource.data).changedKeys())
              || validFavorites(request.resource.data.favorites));

      // El dueño puede borrar su propio doc — deleteAccount (AuthContext) lo
      // intenta ANTES de deleteUser y con 'if false' era rechazado en silencio
      // (catch vacío): el perfil con email/nombre quedaba huérfano PARA SIEMPRE
      // tras borrar la cuenta (Apple 5.1.1(v)). Auditoría 3 jul 2026.
      allow delete: if isOwner(uid);
    }

    // ── usernames/{username} ────────────────────────────────────────────────────
    // Lookup table: username → uid. Enables unique username enforcement.
    match /usernames/{username} {

      // Anyone can check if a username exists (needed for availability search)
      allow read: if request.auth != null;

      // Any authenticated user (including anonymous) can claim a username
      // as long as the uid stored matches their own
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;

      // Any authenticated user can delete their own username entry
      allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;

      allow update: if false; // always delete + create for username swap
    }

    // ── Sports data — public reads, server-only writes ─────────────────────────
    //
    // These collections hold public sports data (scores, standings, top
    // scorers, season indexes, bracket caches). Match results aren't private
    // — every sports site shows them — so we allow unauthenticated reads
    // here, which removes a hard dependency on Firebase Auth being
    // available before the first paint. Writes are blocked at the rule
    // level; only the Cloud Functions service account (via Admin SDK,
    // which bypasses these rules) can populate them.

    /// matches/{matchId} — live + scheduled + finished fixtures
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    /// standings/{seasonId} — league tables
    match /standings/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    /// topscorers/{seasonId} — top scorers per league
    match /topscorers/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    /// season_fixtures/{seasonId} — lightweight per-season fixtures index.
    /// One compact doc (no detail/h2h blobs) powering the league-detail
    /// Partidos list + cup bracket with a single read. Written server-side
    /// by syncFixtures (see functions/src/season-fixtures-index.ts).
    match /season_fixtures/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    /// season_index/{leagueId} — list of available seasons per league
    /// Powers the season picker dropdown in LeagueDetailScreen.
    match /season_index/{leagueId} {
      allow read: if true;
      allow write: if false;
    }

    /// cup_brackets/{seasonId} — cached bracket data for past tournaments
    /// Populated on-demand the first time a user opens a past WC/cup edition.
    match /cup_brackets/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    /// teams/{teamId} — club + national team info (badge, founded, stadium, etc.)
    /// Populated by syncTeams cron daily.
    match /teams/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    /// squads/{seasonId}_{teamId} — full roster per team-season
    /// Populated by syncSquads cron daily.
    match /squads/{squadId} {
      allow read: if true;
      allow write: if false;
    }

    /// coaches/{coachId} — coach profiles + career stats
    /// Populated by syncCoaches cron daily.
    match /coaches/{coachId} {
      allow read: if true;
      allow write: if false;
    }

    /// players/{playerId} — player profiles + season stats
    /// Populated by syncPlayers cron daily.
    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    /// _meta/appVersion — public version manifest read by useVersionCheck on every launch.
    /// Other _meta docs (e.g. livescoresSnapshot) remain server-only.
    match /_meta/appVersion {
      allow read: if true;
      allow write: if false;
    }

    // ── liveActivities/{regId} ──────────────────────────────────────────────────
    // Registro de tokens de Live Activity (doc id = `${matchId}_${uid}`).
    // El cliente crea/actualiza SU registro (incluye invitados — anonymous auth
    // les da uid real); nadie lee desde el cliente (pollLivescores lee con
    // admin y empuja los updates por FCM/APNs).
    match /liveActivities/{regId} {
      allow read: if false;
      allow create, update: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.matchId is string
          && request.resource.data.keys().hasOnly([
               'fcmToken', 'activityPushToken', 'matchId', 'platform',
               'userId', 'createdAt', 'ended', 'lastState'
             ]);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Deny everything else (including the rest of _meta) ────────────────────
    // _meta/livescoresSnapshot is internal diff state for Cloud Functions only —
    // no client should ever need to read it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
